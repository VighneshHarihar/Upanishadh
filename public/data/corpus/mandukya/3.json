[{"id":"MaU_3","ref":"3","section":"Self and consciousness","sa":["जागरितस्थानो बहिष्प्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः","स्थूलभुग्वैश्वानरः प्रथमः पादः ॥ ३॥"],"iast":["jāgaritasthāno bahiṣprajñaḥ saptāṅga ekonaviṃśatimukhaḥ","sthūlabhugvaiśvānaraḥ prathamaḥ pādaḥ ॥ 3॥"],"alt":[{"text":"He whose place is the wakefulness, who is wise of the outward, who has seven limbs, to whom there are nineteen doors, who feeleth and enjoyeth gross objects, Vaiswanor, the Universal Male, He is the first.","by":"Sri Aurobindo","cite":"Sri Aurobindo · CWSA 18, pp. 193–194","source":"upanishads.org.in"}],"words":[["जागरितस्थानः","jāgaritasthānaḥ","whose sphere is waking","jāgaritasthānaḥ"],["बहिष्प्रज्ञः","bahiṣprajñaḥ","outwardly conscious","bahiṣprajñaḥ"],["सप्ताङ्गः","saptāṅgaḥ","having seven limbs","saptāṅgaḥ"],["एकोनविंशतिमुखः","ekonaviṃśatimukhaḥ","having nineteen mouths or openings","ekonaviṃśatimukhaḥ"],["स्थूलभुक्","sthūlabhuk","enjoyer of gross objects","sthūlabhuk"],["वैश्वानरः","vaiśvānaraḥ","Vaiśvānara","vaiśvānaraḥ"],["प्रथमः","prathamaḥ","first","prathamaḥ"],["पादः","pādaḥ","quarter","pādaḥ"]],"tr":{"text":"(The Self) seated in the waking state and called Vaisvanara who, possessed of the consciousness of the exterior, and seven limbs and nineteen mouths, enjoys the gross objects, is the first quarter.","by":"Vidyavachaspati V. Panoli","source":"108 Upanishads (comp. R. Sheppard)"},"audio":{"mp3":"https://s3.ap-south-1.amazonaws.com/upanishaddata/SplitAudio/mandukyopanisad/5.3.mp3","whole":[41.87,58.08]},"hasBhashya":true,"order":4,"up":"mandukya"}]