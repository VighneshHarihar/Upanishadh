[{"id":"MaU_4","ref":"4","section":"Self and consciousness","sa":["स्वप्नस्थानोऽन्तःप्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः","प्रविविक्तभुक्तैजसो द्वितीयः पादः ॥ ४॥"],"iast":["svapnasthāno’ntaḥprajñaḥ saptāṅga ekonaviṃśatimukhaḥ","praviviktabhuktaijaso dvitīyaḥ pādaḥ ॥ 4॥"],"alt":[{"text":"He whose place is the dream, who is wise of the inward, who has seven limbs, to whom there are nineteen doors, who feeleth and enjoyeth subtle objects, Taijasa, the Inhabitant in Luminous Mind, He is the second.","by":"Sri Aurobindo","cite":"Sri Aurobindo · CWSA 18, p. 194","source":"upanishads.org.in"}],"words":[["स्वप्नस्थानः","svapnasthānaḥ","whose sphere is dream","svapnasthānaḥ"],["अन्तःप्रज्ञः","antaḥprajñaḥ","inwardly conscious","antaḥprajñaḥ"],["सप्ताङ्गः","saptāṅgaḥ","having seven limbs","saptāṅgaḥ"],["एकोनविंशतिमुखः","ekonaviṃśatimukhaḥ","having nineteen mouths or openings","ekonaviṃśatimukhaḥ"],["प्रविविक्तभुक्","praviviktabhuk","enjoyer of subtle objects","praviviktabhuk"],["तैजसः","taijasaḥ","Taijasa","taijasaḥ"],["द्वितीयः","dvitīyaḥ","second","dvitīyaḥ"],["पादः","pādaḥ","quarter","pādaḥ"]],"tr":{"text":"(The Self) seated in the state of dream and called Taijasa who, possessed of the consciousness of the interior, and seven limbs and nineteen mouths, enjoys the subtle objects, is the second quarter.","by":"Vidyavachaspati V. Panoli","source":"108 Upanishads (comp. R. Sheppard)"},"audio":{"mp3":"https://s3.ap-south-1.amazonaws.com/upanishaddata/SplitAudio/mandukyopanisad/5.4.mp3","whole":[58.08,74.32]},"hasBhashya":true,"order":5,"up":"mandukya"}]