[{"id":"IU_6","ref":"6","section":"The eighteen mantras","sa":["यस्तु सर्वाणि भूतानि आत्मन्येवानुपश्यति ।","सर्वभूतेषु चात्मानं ततो न विजुगुप्सते ॥६॥"],"iast":["yastu sarvāṇi bhūtāni ātmanyevānupaśyati ।","sarvabhūteṣu cātmānaṃ tato na vijugupsate ॥6॥"],"alt":[{"text":"But he who sees everywhere the Self in all existences and all existences in the Self, shrinks not thereafter from aught.","by":"Sri Aurobindo","cite":"Sri Aurobindo · CWSA 17, p. 7","source":"upanishads.org.in"}],"words":[["यः","yaḥ","he who","ya"],["तु","tu","but","tu"],["सर्वाणि","sarvāṇi","all","sarva"],["भूतानि","bhūtāni","existences","bhūta"],["आत्मनि","ātmani","in the Self","ātman"],["एव","eva","indeed","eva"],["अनुपश्यति","anupaśyati","sees","√dṛś"],["सर्वभूतेषु","sarvabhūteṣu","in all existences","bhūta"],["च","ca","and","ca"],["आत्मानम्","ātmānam","the Self","ātman"],["ततः","tataḥ","thereafter","tat"],["न","na","not","na"],["विजुगुप्सते","vijugupsate","shrinks from aught","√gup"]],"tr":{"text":"He who perceives all beings in the Self alone, and the Self in all beings, does not entertain any hatred on account of that perception.","by":"Vidyavachaspati V. Panoli","source":"108 Upanishads (comp. R. Sheppard)"},"audio":{"mp3":"https://s3.ap-south-1.amazonaws.com/upanishaddata/SplitAudio/Isopanisad/1.6.mp3","whole":[94.57,109.47]},"hasBhashya":true,"order":7,"up":"isha","takeaway":"When you see yourself in others and others in yourself, contempt has nowhere to stand."}]