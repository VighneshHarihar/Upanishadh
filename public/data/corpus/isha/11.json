[{"id":"IU_11","ref":"11","section":"The eighteen mantras","sa":["विद्याञ्च अविद्याञ्च यस्तद् वेदोभयं सह ।","अविद्यया मृत्युं तीर्त्वा विद्ययामृतमश्नुते ॥११॥"],"iast":["vidyāñca avidyāñca yastad vedobhayaṃ saha ।","avidyayā mṛtyuṃ tīrtvā vidyayāmṛtamaśnute ॥11॥"],"alt":[{"text":"He who knows That as both in one, the Knowledge and the Ignorance, by the Ignorance crosses beyond death and by the Knowledge enjoys Immortality.","by":"Sri Aurobindo","cite":"Sri Aurobindo · CWSA 17, p. 8","source":"upanishads.org.in"}],"words":[["विद्याम्","vidyām","Knowledge","vidyā"],["च","ca","and","ca"],["अविद्याम्","avidyām","Ignorance","vidya"],["च","ca","and","ca"],["यः","yaḥ","He who","ya"],["तत्","tat","That","tat"],["वेद","veda","knows","√vid"],["उभयम्","ubhayam","both","ubhaya"],["सह","saha","in one","saha"],["अविद्यया","avidyayā","by the Ignorance","vidyā"],["मृत्युम्","mṛtyum","death","mṛtyu"],["तीर्त्वा","tīrtvā","crosses beyond","tīr"],["विद्यया","vidyayā","by the Knowledge","vidyā"],["अमृतम्","amṛtam","Immortality","mṛta"],["अश्नुते","aśnute","enjoys","√aś"]],"tr":{"text":"He who knows both vidya and avidya together, transcends mortality through avidya and reaches immortality through vidya.","by":"Vidyavachaspati V. Panoli","source":"108 Upanishads (comp. R. Sheppard)"},"audio":{"mp3":"https://s3.ap-south-1.amazonaws.com/upanishaddata/SplitAudio/Isopanisad/1.11.mp3","whole":[178.86,193.32]},"hasBhashya":false,"order":12,"up":"isha"}]