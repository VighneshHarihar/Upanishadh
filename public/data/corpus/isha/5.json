[{"id":"IU_5","ref":"5","section":"The eighteen mantras","sa":["तदेजति तन्नैजति तद् दूरे तद्वन्तिके ।","तदन्तरस्य सर्वस्य तदु सर्वस्यास्य बाह्यतः ॥५॥"],"iast":["tadejati tannaijati tad dūre tadvantike ।","tadantarasya sarvasya tadu sarvasyāsya bāhyataḥ ॥5॥"],"alt":[{"text":"That moves and That moves not; That is far and the same is near; That is within all this and That also is outside all this.","by":"Sri Aurobindo","cite":"Sri Aurobindo · CWSA 17, p. 6","source":"upanishads.org.in"}],"words":[["तत्","tat","That","ta"],["एजति","ejati","moves","√ej"],["तत्","tat","That","ta"],["न","na","not","na"],["एजति","ejati","moves","√ej"],["तत्","tat","That","ta"],["दूरे","dūre","is far","dūra"],["तत्","tat","the same","ta"],["उ","u","also / emphasis","u"],["अन्तिके","antike","is near","antika"],["तत्","tat","That","ta"],["अन्तर्","antar","is within","antar"],["अस्य","asya","of this","asya"],["सर्वस्य","sarvasya","all this","sarva"],["तत्","tat","That","ta"],["उ","u","also","u"],["सर्वस्य","sarvasya","all this","sarva"],["अस्य","asya","of this","asya"],["बाह्यतः","bāhyataḥ","is outside","bāhya"]],"tr":{"text":"It moves; It moves not. It is far; It is near. It is within all; It is without all.","by":"Vidyavachaspati V. Panoli","source":"108 Upanishads (comp. R. Sheppard)"},"audio":{"mp3":"https://s3.ap-south-1.amazonaws.com/upanishaddata/SplitAudio/Isopanisad/1.5.mp3","whole":[79.81,94.57]},"hasBhashya":true,"order":6,"up":"isha"}]